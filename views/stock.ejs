<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= symbol %> - Stock | Mudraaa</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Inter", Arial, sans-serif;
        }

        body {
            background: linear-gradient(180deg, #0D1117 0%, #10161f 100%);
            color: #e6edf3;
            min-height: 100vh;
        }

        .page {
            max-width: 1000px;
            margin: 0 auto;
            padding: 24px 16px 60px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 18px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #8b949e;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color .2s ease;
        }
        .back-link:hover {
            color: #e6edf3;
        }

        .theme-toggle {
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            color: #c9d1d9;
            background: #21262d;
            border: 1px solid #2D333B;
            border-radius: 8px;
            cursor: pointer;
            transition: all .2s ease;
        }
        .theme-toggle:hover {
            background: #30363d;
            color: #fff;
        }

        .card {
            background: #161B22;
            border: 1px solid #2D333B;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .card-title {
            font-size: 13px;
            font-weight: 700;
            color: #8b949e;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 14px;
        }

        /* Header */
        .stock-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            flex-wrap: wrap;
        }

        .stock-title {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .symbol {
            font-size: 30px;
            font-weight: 800;
            color: #ffffff;
        }

        .sector-badge {
            font-size: 12px;
            font-weight: 600;
            color: #2EA043;
            background: rgba(46, 160, 67, 0.12);
            border-radius: 20px;
            padding: 5px 12px;
        }

        .stock-name {
            font-size: 15px;
            color: #8b949e;
            margin-top: 4px;
            width: 100%;
        }

        .price-block {
            text-align: right;
        }

        .price {
            font-size: 38px;
            font-weight: 800;
            color: #ffffff;
        }

        .change-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
            font-size: 15px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 20px;
        }

        .change-pill.up {
            color: #16a34a;
            background: rgba(22, 163, 74, 0.14);
        }
        .change-pill.down {
            color: #dc2626;
            background: rgba(220, 38, 38, 0.14);
        }

        .updated-at {
            font-size: 12px;
            color: #8b949e;
            margin-top: 8px;
        }

        /* Stats grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .stat {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid #2D333B;
            border-radius: 10px;
            padding: 14px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            color: #8b949e;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }

        .stat-value {
            font-size: 17px;
            font-weight: 700;
            color: #e6edf3;
        }

        .stat-value.up { color: #16a34a; }
        .stat-value.down { color: #dc2626; }
        .stat-value.gray { color: #8b949e; }

        /* Info list */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 4px 30px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 11px 0;
            border-bottom: 1px solid #21262d;
            font-size: 14px;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #8b949e;
        }

        .info-value {
            font-weight: 600;
            color: #e6edf3;
            text-align: right;
        }

        .info-value a {
            color: #2EA043;
            text-decoration: none;
        }
        .info-value a:hover {
            text-decoration: underline;
        }

        /* Shareholding */
        .holding-bar {
            height: 12px;
            border-radius: 10px;
            background: #21262d;
            overflow: hidden;
            display: flex;
            margin-bottom: 14px;
        }

        .holding-bar .public {
            background: linear-gradient(90deg, #238636, #2EA043);
        }

        .holding-bar .promoter {
            background: #30363d;
        }

        .holding-legend {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            font-size: 13px;
            color: #8b949e;
        }

        /* Price chart */
        .chart-wrap {
            position: relative;
            width: 100%;
            height: 320px;
        }

        .chart-wrap canvas {
            width: 100% !important;
            height: 100% !important;
        }

        .chart-empty {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8b949e;
            font-size: 14px;
        }

        .holding-legend .dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 6px;
            vertical-align: middle;
        }

        .dot.public { background: #2EA043; }
        .dot.promoter { background: #30363d; }

        .loading {
            color: #8b949e;
            font-size: 14px;
        }

        .hidden {
            display: none;
        }

        /* ===========================
           Light theme (matches dashboard)
        =========================== */
        .light-theme {
            background: #f5f7fa;
            color: #111827;
        }

        .light-theme .card {
            background: #ffffff;
            border-color: #e5e7eb;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        }

        .light-theme .card-title,
        .light-theme .stat-label,
        .light-theme .info-label,
        .light-theme .updated-at,
        .light-theme .stock-name,
        .light-theme .back-link {
            color: #6b7280;
        }

        .light-theme .symbol,
        .light-theme .price,
        .light-theme .stat-value,
        .light-theme .info-value {
            color: #111827;
        }

        .light-theme .stat {
            background: #ffffff;
            border-color: #e5e7eb;
        }

        .light-theme .info-row {
            border-bottom-color: #f0f2f5;
        }

        .light-theme .holding-bar {
            background: #f0f2f5;
        }
        .light-theme .holding-bar .promoter {
            background: #d1d5db;
        }
        .light-theme .holding-legend {
            color: #4b5563;
        }
        .light-theme .dot.promoter {
            background: #d1d5db;
        }

        .light-theme .theme-toggle {
            background: #f0f2f5;
            border-color: #e5e7eb;
            color: #4b5563;
        }
        .light-theme .theme-toggle:hover {
            background: #e5e7eb;
            color: #111827;
        }

        .light-theme .back-link:hover {
            color: #111827;
        }

        @media (max-width: 720px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .info-grid {
                grid-template-columns: 1fr;
            }
            .stock-header {
                flex-direction: column;
            }
            .price-block {
                text-align: left;
            }
            .symbol {
                font-size: 24px;
            }
        }

        @media (max-width: 480px) {
            .page {
                padding: 16px 10px 50px;
            }
            .card {
                padding: 16px;
            }
            .price {
                font-size: 30px;
            }
            .topbar {
                padding: 0 4px;
            }
            .theme-toggle {
                padding: 7px 12px;
                font-size: 12px;
            }
            .stats-grid {
                gap: 8px;
            }
        }
    </style>
</head>

<body>

<div class="page">

    <div class="topbar">
        <a class="back-link" href="/dashboard">&larr; Back to Dashboard</a>
        <button class="theme-toggle" id="themeToggle">Dark Mode</button>
    </div>

    <div class="card">
        <div class="stock-header">
            <div class="stock-title">
                <div class="symbol"><%= symbol %></div>
                <span class="sector-badge" id="sectorBadge">--</span>
                <div class="stock-name" id="stockName">--</div>
            </div>
            <div class="price-block">
                <div class="price" id="ltp">Loading...</div>
                <div class="change-pill hidden" id="changePill"></div>
                <div class="updated-at hidden" id="updatedAt"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Price Trend</div>
        <div class="chart-wrap">
            <canvas id="priceChart"></canvas>
            <div class="chart-empty hidden" id="chartEmpty">No price data available</div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Today's Trade</div>
        <div class="stats-grid" id="todayStats">
            <div class="stat"><div class="stat-label">Open</div><div class="stat-value gray" id="sOpen">-</div></div>
            <div class="stat"><div class="stat-label">High</div><div class="stat-value up" id="sHigh">-</div></div>
            <div class="stat"><div class="stat-label">Low</div><div class="stat-value down" id="sLow">-</div></div>
            <div class="stat"><div class="stat-label">Prev Close</div><div class="stat-value gray" id="sPrev">-</div></div>
            <div class="stat"><div class="stat-label">Volume</div><div class="stat-value" id="sVolume">-</div></div>
            <div class="stat"><div class="stat-label">Trades</div><div class="stat-value" id="sTrades">-</div></div>
            <div class="stat"><div class="stat-label">52W High</div><div class="stat-value up" id="s52High">-</div></div>
            <div class="stat"><div class="stat-label">52W Low</div><div class="stat-value down" id="s52Low">-</div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Company Details</div>
        <div class="info-grid" id="companyInfo">
            <div class="info-row"><span class="info-label">Sector</span><span class="info-value" id="cSector">-</span></div>
            <div class="info-row"><span class="info-label">Face Value</span><span class="info-value" id="cFace">-</span></div>
            <div class="info-row"><span class="info-label">Market Cap</span><span class="info-value" id="cMarketCap">-</span></div>
            <div class="info-row"><span class="info-label">Paid-up Capital</span><span class="info-value" id="cPaidUp">-</span></div>
            <div class="info-row"><span class="info-label">Listed Shares</span><span class="info-value" id="cListed">-</span></div>
            <div class="info-row"><span class="info-label">ISIN</span><span class="info-value" id="cIsin">-</span></div>
            <div class="info-row"><span class="info-label">Listing Date</span><span class="info-value" id="cListing">-</span></div>
            <div class="info-row"><span class="info-label">Website</span><span class="info-value" id="cWebsite">-</span></div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">Shareholding Structure</div>
        <div class="holding-bar">
            <div class="public" id="publicBar"></div>
            <div class="promoter" id="promoterBar"></div>
        </div>
        <div class="holding-legend">
            <span><span class="dot public"></span>Public <strong id="publicPct">-</strong></span>
            <span><span class="dot promoter"></span>Promoter <strong id="promoterPct">-</strong></span>
        </div>
    </div>

    <p class="updated-at">Data courtesy of NEPSE. Refresh the page to update.</p>

</div>

<script src="/js/chart.js"></script>

<script>
    const symbol = "<%= symbol %>";

    const nf = new Intl.NumberFormat("en-IN");

    function crore(value) {
        const v = Number(value || 0);
        return nf.format(v) + " (" + (v / 10000000).toFixed(2) + " Cr)";
    }

    // Theme (matches dashboard behaviour)
    function applyTheme() {
        const saved = localStorage.getItem("theme");

        if (saved === "light") {
            document.body.classList.add("light-theme");
            document.getElementById("themeToggle").textContent = "Dark Mode";
        } else {
            document.body.classList.remove("light-theme");
            document.getElementById("themeToggle").textContent = "Light Mode";
        }
    }

    document.getElementById("themeToggle").addEventListener("click", function () {
        document.body.classList.toggle("light-theme");

        const isLight = document.body.classList.contains("light-theme");

        localStorage.setItem("theme", isLight ? "light" : "dark");

        document.getElementById("themeToggle").textContent =
            isLight ? "Dark Mode" : "Light Mode";

        if (window.redrawCharts) {
            window.redrawCharts();
        }
    });

    applyTheme();

    async function loadStock() {
        try {
            const response = await fetch(`/api/CompanyDetails/${encodeURIComponent(symbol)}`);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();

            const dto = data.securityDailyTradeDto || {};
            const sec = data.security || {};
            const company = sec.companyId || {};

            const ltp = Number(dto.lastTradedPrice || 0);
            const prevClose = Number(dto.previousClose || 0);
            const change = ltp - prevClose;
            const changePercent = prevClose ? (change / prevClose) * 100 : 0;
            const up = change >= 0;

            // Header
            document.getElementById("ltp").textContent = ltp.toFixed(2);
            document.getElementById("stockName").textContent =
                sec.securityName || company.companyName || symbol;
            document.getElementById("sectorBadge").textContent =
                (company.sectorMaster && company.sectorMaster.sectorDescription) ||
                sec.instrumentType?.description || "--";

            const pill = document.getElementById("changePill");
            pill.textContent = `${up ? "+" : ""}${change.toFixed(2)} (${up ? "+" : ""}${changePercent.toFixed(2)}%)`;
            pill.classList.remove("hidden", "up", "down");
            pill.classList.add(up ? "up" : "down");

            const updated = document.getElementById("updatedAt");
            updated.classList.remove("hidden");
            updated.textContent = dto.lastUpdatedDateTime
                ? "Updated " + new Date(dto.lastUpdatedDateTime).toLocaleString()
                : (dto.businessDate || "");

            // Today's trade
            document.getElementById("sOpen").textContent = Number(dto.openPrice || 0).toFixed(2);
            document.getElementById("sHigh").textContent = Number(dto.highPrice || 0).toFixed(2);
            document.getElementById("sLow").textContent = Number(dto.lowPrice || 0).toFixed(2);
            document.getElementById("sPrev").textContent = prevClose.toFixed(2);
            document.getElementById("sVolume").textContent = nf.format(Number(dto.totalTradeQuantity || 0));
            document.getElementById("sTrades").textContent = nf.format(Number(dto.totalTrades || 0));
            document.getElementById("s52High").textContent = Number(dto.fiftyTwoWeekHigh || 0).toFixed(2);
            document.getElementById("s52Low").textContent = Number(dto.fiftyTwoWeekLow || 0).toFixed(2);

            // Company details
            document.getElementById("cSector").textContent =
                (company.sectorMaster && company.sectorMaster.sectorDescription) || "--";
            document.getElementById("cFace").textContent =
                Number(sec.faceValue || 0).toFixed(0) + " NPR";
            document.getElementById("cMarketCap").textContent = crore(data.marketCapitalization);
            document.getElementById("cPaidUp").textContent = crore(data.paidUpCapital);
            document.getElementById("cListed").textContent = nf.format(Number(data.stockListedShares || 0));
            document.getElementById("cIsin").textContent = sec.isin || "--";
            document.getElementById("cListing").textContent =
                sec.listingDate ? new Date(sec.listingDate).toLocaleDateString() : "--";

            const website = document.getElementById("cWebsite");
            if (company.companyWebsite) {
                const url = company.companyWebsite.startsWith("http")
                    ? company.companyWebsite
                    : "http://" + company.companyWebsite;
                website.innerHTML = `<a href="${url}" target="_blank" rel="noopener">${company.companyWebsite}</a>`;
            } else {
                website.textContent = "--";
            }

            // Shareholding
            const pub = Number(data.publicPercentage || 0);
            const pro = Number(data.promoterPercentage || 0);
            const total = pub + pro || 100;

            document.getElementById("publicBar").style.flex = (pub / total) + " 1 0%";
            document.getElementById("promoterBar").style.flex = (pro / total) + " 1 0%";
            document.getElementById("publicPct").textContent = pub.toFixed(2) + "%";
            document.getElementById("promoterPct").textContent = pro.toFixed(2) + "%";

        } catch (error) {
            console.error("Stock API error:", error);

            document.getElementById("ltp").textContent = "Unavailable";
            document.getElementById("sectorBadge").textContent = "--";
        }
    }

    loadStock();

    async function loadPriceGraph() {
        try {
            const response = await fetch(
                `/api/DailyScripPriceGraph?symbol=${encodeURIComponent(symbol)}`
            );

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();

            if (!Array.isArray(data) || data.length === 0) {
                document.getElementById("chartEmpty").classList.remove("hidden");
                return;
            }

            const labels = data.map(p =>
                new Date(p.time * 1000).toLocaleTimeString([], {
                    hour: "2-digit",
                    minute: "2-digit"
                })
            );

            const values = data.map(p => Number(p.contractRate ?? 0));

            drawLineChart("priceChart", labels, values);

        } catch (error) {
            console.error("Price graph error:", error);

            document.getElementById("chartEmpty").classList.remove("hidden");
        }
    }

    loadPriceGraph();
</script>

</body>
</html>
