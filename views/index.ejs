<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
<title>Mudraaa | Live NEPSE Market Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/index.css">
</head>
<body class="light-theme">

<nav class="navbar">
    <a class="logo" href="/" aria-label="Mudraaa home">
        <img class="logo-img" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high">
    </a>
    <div class="nav-links">
        <button id="langBtn" class="btn btn-ghost btn-sm">नेपाली</button>
        <button id="themeBtn" class="btn btn-ghost btn-sm"></button>
        <a class="btn btn-ghost" data-i18n="navLogin" href="/login">Log In</a>
        <a class="btn btn-primary" data-i18n="navSignup" href="/signup">Sign Up</a>
    </div>
</nav>

<section class="hero">
    <video class="hero-video" autoplay muted loop playsinline>
        <source src="/img/hero.mp4" type="video/mp4">
    </video>
    <h1 data-i18n="heroTitle">Live NEPSE Market <span>Intelligence</span>, Built for Traders</h1>
    <p data-i18n="heroDesc">Track the NEPSE index in real time, explore top gainers and losers, dive into detailed stock charts, and join our community of investors to share ideas.</p>
    <div class="hero-btns">
        <a class="btn btn-primary" data-i18n="heroSignup" href="/signup">Create Free Account</a>
        <a class="btn btn-ghost" data-i18n="heroLogin" href="/login">Log In</a>
    </div>
</section>

<div class="ad-container">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-1684472482346109"
         data-ad-slot="7457108131"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>

    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</div>

<section class="market">
    <div class="card">
        <div class="card-title" data-i18n="cardNepse">NEPSE Index</div>
        <span id="nepseIndex">Loading...</span>
        <span id="changePercent">Loading...</span>
        <div class="stats-grid">
            <div class="stat">
                <span class="stat-label" data-i18n="statChange">Change</span>
                <span class="stat-value" id="change">-</span>
            </div>
            <div class="stat">
                <span class="stat-label" data-i18n="statHigh">High</span>
                <span class="stat-value" id="high">-</span>
            </div>
            <div class="stat">
                <span class="stat-label" data-i18n="statLow">Low</span>
                <span class="stat-value" id="low">-</span>
            </div>
        </div>
        <div class="global-ticker">
            <div class="ticker-item">
                <span class="ticker-icon gold">Au</span>
                <div class="ticker-info">
                    <span class="ticker-label">Gold/तोला</span>
                    <span class="ticker-price" id="goldPrice">--</span>
                </div>
                <span class="ticker-change" id="goldChange">--</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-title" data-i18n="cardWhy">Why Mudraaa?</div>
        <p class="card-text" data-i18n="whyText" style="font-size:14px;color:var(--muted);line-height:1.7;">
            Real-time market overview, interactive index charts, sub-indices at a glance, and a premium investor chat room — all in one clean dashboard.
        </p>
    </div>
    <div class="card">
        <div class="card-title" data-i18n="cardStart">Get Started</div>
        <p class="card-text" data-i18n="startText" style="font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:16px;">
            Create your account in seconds and unlock the full NEPSE experience.
        </p>
        <a class="btn btn-primary" data-i18n="startBtn" href="/signup">Get Started</a>
    </div>
    <div class="card submarquee">
        <div class="showindexsub"></div>
    </div>
</section>

<section class="chart-section">
    <div class="card chart-card">
        <div class="card-title" data-i18n="chartTitle">NEPSE Index Trend</div>
        <div class="index-chart-wrap">
            <canvas id="indexChart"></canvas>
        </div>
    </div>
</section>

<section class="features">
    <div class="feature">
        <h3 data-i18n="featRealTime">Real-time Data</h3>
        <p data-i18n="featRealTimeText">Live NEPSE index, top gainers, losers, turnover and volume updates refreshed automatically.</p>
    </div>
    <div class="feature">
        <h3 data-i18n="featCharts">Interactive Charts</h3>
        <p data-i18n="featChartsText">Explore index trends and per-stock price graphs with clean, readable visualizations.</p>
    </div>
    <div class="feature">
        <h3 data-i18n="featCommunity">Investor Community</h3>
        <p data-i18n="featCommunityText">Join the chat room, share market ideas and suggestions with fellow traders.</p>
    </div>
</section>

<footer class="footer" data-i18n="footer">Mudraaa &copy; 2026.  financial market data provided for informational purposes only.
</footer>

<script src="/js/chart.js"></script>
<script src="/js/index.js"></script>
</body>
</html>
