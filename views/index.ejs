<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/png" href="\img\logo.png">
<link rel="apple-touch-icon" href="\img\logo.png">
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-B5V2XQ7G14"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-B5V2XQ7G14');
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
<title>Mudraaa | Live NEPSE Market Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/index.css">
</head>
<body class="light-theme">

<nav class="navbar">
    <a class="logo" href="/" aria-label="Mudraaa home">
        <img class="logo-img" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high" width="140" height="40" decoding="async">
    </a>
    <div class="nav-links">
        <a class="btn btn-ghost" href="/news">News</a>
        <button id="langBtn" class="btn btn-ghost btn-sm">नेपाली</button>
        <button id="themeBtn" class="btn btn-ghost btn-sm"></button>
        <a class="btn btn-ghost" data-i18n="navLogin" href="/login">Log In</a>
        <a class="btn btn-primary" data-i18n="navSignup" href="/signup">Sign Up</a>
    </div>
</nav>

<% if (topNews && topNews.length > 0) { %>
<section class="home-news">
    <div class="home-news__header">
        <h2 class="home-news__title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Top Market News
        </h2>
        <a href="/news" class="home-news__link">View All &rarr;</a>
    </div>
    <div class="home-news__grid">
        <% for (var i = 0; i < topNews.length; i++) { %>
        <a href="/news/<%= topNews[i]._id %>" class="home-news__card">
            <div class="home-news__card-img">
                <% if (topNews[i].featuredImage) { %>
                    <img src="<%= topNews[i].featuredImage %>" alt="<%= topNews[i].title %>" loading="lazy" width="400" height="260" decoding="async">
                <% } else { %>
                    <div class="home-news__card-placeholder">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                    </div>
                <% } %>
                <span class="home-news__rank">#<%= i + 1 %></span>
            </div>
            <div class="home-news__card-body">
                <% if (topNews[i].category) { %>
                    <span class="home-news__cat"><%= topNews[i].category %></span>
                <% } %>
                <h3 class="home-news__card-title"><%= topNews[i].title %></h3>
                <div class="home-news__card-meta">
                    <span><%= topNews[i]._date %></span>
                    <span class="home-news__views">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <%= topNews[i].views || 0 %>
                    </span>
                    <% if (topNews[i]._authorName) { %>
                        <span>by <%= topNews[i]._authorName %></span>
                    <% } %>
                </div>
            </div>
        </a>
        <% } %>
    </div>
</section>
<% } %>





<section class="market">
    <div class="card">
        <div class="card-title" data-i18n="cardNepse">NEPSE Index</div>
        <span id="nepseIndex">Loading...</span>
        <span id="changePercent">Loading...</span>
        <div class="stats-grid">
            <div class="stat">
                <span class="stat-label" data-i18n="statChange">Change</span>
                <span class="stat-value" id="change">-</span>
            </div>
            <div class="stat">
                <span class="stat-label" data-i18n="statHigh">High</span>
                <span class="stat-value" id="high">-</span>
            </div>
            <div class="stat">
                <span class="stat-label" data-i18n="statLow">Low</span>
                <span class="stat-value" id="low">-</span>
            </div>
        </div>
        <div class="global-ticker">
            <div class="ticker-item">
                <span class="ticker-icon gold">Au</span>
                <div class="ticker-info">
                    <span class="ticker-label">Gold/तोला</span>
                    <span class="ticker-price" id="goldPrice">--</span>
                </div>
                <span class="ticker-change" id="goldChange">--</span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-title" data-i18n="cardWhy">Why Mudraaa?</div>
        <p class="card-text" data-i18n="whyText" style="font-size:14px;color:var(--muted);line-height:1.7;">
            Real-time market overview, interactive index charts, sub-indices at a glance, and a premium investor chat room — all in one clean dashboard.
        </p>
    </div>
    <div class="card">
        <div class="card-title" data-i18n="cardStart">Get Started</div>
        <p class="card-text" data-i18n="startText" style="font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:16px;">
            Create your account in seconds and unlock the full NEPSE experience.
        </p>
        <a class="btn btn-primary" data-i18n="startBtn" href="/signup">Get Started</a>
    </div>
    <div class="card submarquee">
        <div class="showindexsub"></div>
    </div>
</section>

<section class="chart-section">
    <div class="card chart-card">
        <div class="card-title" data-i18n="chartTitle">NEPSE Index Trend</div>
        <div class="index-chart-wrap">
            <canvas id="indexChart"></canvas>
        </div>
    </div>
</section>

<section class="features">
    <div class="feature">
        <h3 data-i18n="featRealTime">Real-time Data</h3>
        <p data-i18n="featRealTimeText">Live NEPSE index, top gainers, losers, turnover and volume updates refreshed automatically.</p>
    </div>
    <div class="feature">
        <h3 data-i18n="featCharts">Interactive Charts</h3>
        <p data-i18n="featChartsText">Explore index trends and per-stock price graphs with clean, readable visualizations.</p>
    </div>
    <div class="feature">
        <h3 data-i18n="featCommunity">Investor Community</h3>
        <p data-i18n="featCommunityText">Join the chat room, share market ideas and suggestions with fellow traders.</p>
    </div>
</section>

<div class="ad-container">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-1684472482346109"
         data-ad-slot="7457108131"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>

    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</div>

<footer class="footer" data-i18n="footer">Mudraaa &copy; 2026.  financial market data provided for informational purposes only.
</footer>

<script src="/js/chart.js"></script>
<script src="/js/index.js"></script>
</body>
</html>
