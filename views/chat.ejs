<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-B5V2XQ7G14"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-B5V2XQ7G14');
</script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
 crossorigin="anonymous"></script>

<title>Premium Chat | Mudraaa</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/chat.css">
<meta name="username" content="<%= user.username %>">
</head>

<body>

<!-- ===== SIDEBAR OVERLAY (mobile) ===== -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- ===== SIDEBAR ===== -->
<aside class="sidebar">
    <div class="sidebar-inner">
        <div class="sidebar-brand">
            <img class="sidebar-logo" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high">
            <span class="sidebar-brand-text">Mudraaa</span>
        </div>

        <nav class="sidebar-nav">
            <a href="/dashboard" class="sidebar-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                <span>Dashboard</span>
            </a>
            <a href="/chat" class="sidebar-link active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <span>Chat Room</span>
            </a>
            <a href="/commodities" class="sidebar-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                <span>Commodities</span>
            </a>
            <a href="/crypto" class="sidebar-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                <span>Crypto</span>
            </a>
            <a href="/post-news" class="sidebar-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                <span>Post News</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <img class="sidebar-avatar" src="<%= user.avatar ? '/uploads/' + user.avatar : '/img/profile.png' %>" alt="Profile">
                <div class="sidebar-user-info">
                    <span class="sidebar-username"><%= user.username %></span>
                    <span class="sidebar-useremail"><%= user.email %></span>
                </div>
            </div>
        </div>
    </div>
</aside>

<!-- ===== MAIN CONTENT ===== -->
<div class="main chat-main">

    <!-- Header -->
    <header class="header">
        <div class="header-left">
            <button class="mobile-menu-btn" id="mobileMenuBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            <div>
                <h1 class="header-title">Premium Discussion</h1>
                <p class="header-sub">NEPSE traders community</p>
            </div>
        </div>
        <div class="header-right">
            <div class="online">
                <span class="pulse"></span>
                <span class="online-text" id="onlineCount">0 Traders Online</span>
            </div>
            <div class="header-controls">
                <button id="themeBtn" class="ctrl-btn" title="Theme">
                    <svg class="ctrl-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
                <div class="header-user" id="headerAvatar">
                    <img src="<%= user.avatar ? '/uploads/' + user.avatar : '/img/profile.png' %>" alt="Profile">
                </div>
            </div>
        </div>
    </header>

    <!-- Chat Area + Users Panel (side by side) -->
    <div class="chat-layout">

        <div class="chat-area">

            <div class="messages" id="messages">

                <% messages.forEach(msg => { %>

                    <div class="msg <%= msg.username === user.username ? 'mine' : 'theirs' %>">
                        <div class="msg-avatar"><%= (msg.username || "?").slice(0,2).toUpperCase() %></div>
                        <div class="msg-body">
                            <div class="msg-meta">
                                <span class="msg-name"><%= msg.username %></span>
                                <span class="msg-time"><%= new Date(msg.createdAt).toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"}) %></span>
                            </div>
                            <div class="msg-bubble"><%= msg.message %></div>
                        </div>
                    </div>

                <% }) %>

            </div>

            <div class="inputArea">

                <input id="input" type="text" placeholder="Share your market view..." autocomplete="off">

                <button id="send">
                    Send
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>

            </div>

        </div>

        <div class="users" id="users">

            <div class="side-label">Online Traders</div>

            <div class="users-empty">Connecting...</div>

        </div>

    </div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/theme.js"></script>
<script>

const socket = io();

const username = "<%= user.username %>";
const myAvatar = "<%= user.avatar ? '/uploads/' + user.avatar : '' %>";

const input = document.getElementById("input");
const send = document.getElementById("send");
const messages = document.getElementById("messages");
const users = document.getElementById("users");
const onlineCount = document.getElementById("onlineCount");

initThemeToggle('themeBtn');

// Mobile sidebar
const mobileMenuBtn = document.getElementById("mobileMenuBtn");
const sidebar = document.querySelector(".sidebar");
const overlay = document.getElementById("sidebarOverlay");

mobileMenuBtn.addEventListener("click", function() {
    sidebar.classList.toggle("open");
    overlay.classList.toggle("visible");
});
overlay.addEventListener("click", function() {
    sidebar.classList.remove("open");
    overlay.classList.remove("visible");
});

socket.emit("join", username);

function avatarHTML(name, imgUrl) {
    const initials = String(name || "?").slice(0, 2).toUpperCase();

    return imgUrl
        ? `<img src="${imgUrl}" alt="" loading="lazy">`
        : initials;
}

function createMessageHTML(data, mine) {
    const div = document.createElement("div");

    div.className = "msg " + (mine ? "mine" : "theirs");

    const imgUrl = mine && myAvatar ? myAvatar : "";

    div.innerHTML = `
        <div class="msg-avatar">${avatarHTML(data.username, imgUrl)}</div>
        <div class="msg-body">
            <div class="msg-meta">
                <span class="msg-name">${data.username}</span>
                <span class="msg-time">${data.time}</span>
            </div>
            <div class="msg-bubble"></div>
        </div>
    `;

    div.querySelector(".msg-bubble").textContent = data.message;

    return div;
}

send.onclick = () => {
    if (input.value.trim() === "") return;

    socket.emit("chat message", { message: input.value });

    input.value = "";
    input.focus();
};

input.addEventListener("keypress", e => {
    if (e.key === "Enter") send.click();
});

socket.on("chat message", data => {
    const mine = data.username === username;

    messages.appendChild(createMessageHTML(data, mine));
    messages.scrollTop = messages.scrollHeight;
});

socket.on("online", list => {
    onlineCount.textContent = list.length + " Trader" + (list.length === 1 ? "" : "s") + " Online";

    if (list.length === 0) {
        users.innerHTML = `<div class="side-label">Online Traders</div><div class="users-empty">No one online right now</div>`;
        return;
    }

    users.innerHTML = `<div class="side-label">Online Traders</div>` +
        list.map(name => `
            <div class="user">
                <div class="msg-avatar">${avatarHTML(name, "")}</div>
                <span class="user-name">${name}</span>
                <span class="status-dot"></span>
            </div>
        `).join("");
});

window.onload = () => {
    messages.scrollTop = messages.scrollHeight;
};

</script>

</body>

</html>
