<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Premium Chat | BullChat</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">


<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Inter,sans-serif;
}


body{
background:#0D1117;
color:#F0F6FC;
height:100vh;
display:flex;
overflow:hidden;
}


/* Sidebar */

.sidebar{

width:240px;
background:#161B22;
border-right:1px solid #2D333B;
padding:25px;

}


.logo{

font-size:26px;
font-weight:700;
margin-bottom:40px;

}


.logo span{

color:#2EA043;

}


.channel{

padding:14px;
border-radius:8px;
background:#2EA043;
color:white;

}



/* Chat */

.chat{

flex:1;
display:flex;
flex-direction:column;

}


.header{

height:70px;
border-bottom:1px solid #2D333B;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 30px;

}


.online{

color:#2EA043;

}



/* Messages */

.messages{

flex:1;
overflow-y:auto;
padding:25px;

}


.message{

margin-bottom:20px;

}


.name{

font-weight:600;
margin-bottom:6px;

}


.time{

font-size:12px;
color:#8B949E;
margin-left:10px;

}


.text{

display:inline-block;
background:#161B22;
padding:12px 16px;
border-radius:10px;
max-width:80%;
word-break:break-word;

}



/* Input */


.inputArea{

display:flex;
gap:10px;
padding:20px;
border-top:1px solid #2D333B;

}


.inputArea input{

flex:1;
padding:15px;
background:#161B22;
border:1px solid #2D333B;
color:white;
border-radius:8px;

}


.inputArea button{

padding:15px 25px;
background:#2EA043;
border:none;
color:white;
border-radius:8px;
cursor:pointer;

}



/* Users */


.users{

width:250px;
background:#161B22;
border-left:1px solid #2D333B;
padding:25px;

}


.user{

padding:12px;
display:flex;
gap:10px;

}


.dot{

height:10px;
width:10px;
background:#2EA043;
border-radius:50%;

}



/* Mobile */


@media(max-width:768px){


.sidebar{

display:none;

}


.users{

display:none;

}


.header{

padding:15px;

}


.messages{

padding:15px;

}


.inputArea{

padding:10px;

}


}

.message {
    max-width: 70%;
    width: fit-content;
    box-sizing: border-box;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.my-message {
    padding: 10px;
    background-color: rgba(46, 135, 105, 0.375);
    border-radius: 10px;
    margin-left: auto;
    margin-right: 10px;
    text-align: right;
}

.other-message {
    border-radius: 10px;
    padding: 10px;
    background-color: rgba(112, 112, 110, 0.375);
    margin-left: 10px;
    margin-right: auto;
    text-align: left;
}


</style>

</head>


<body>



<div class="sidebar">

<div class="logo">

📈 Bull<span>Chat</span>

</div>


<div class="channel">

# Premium Room

</div>


</div>





<div class="chat">


<div class="header">

<h2>
Premium Discussion
</h2>


<div class="online">

● 128 Traders Online

</div>


</div>





<div class="messages" id="messages">


<!-- Old MongoDB Messages -->


<% messages.forEach(msg => { %>

    <div class="message <%= msg.username === user.username ? 'my-message' : 'other-message' %>">

        <div class="message-header" style="font-size: 14px;">
            <%= msg.username %>
            <span style="font-size: 10px;">
                <%= new Date(msg.createdAt).toLocaleTimeString() %>
            </span>
        </div>

        <div class="message-text" style="font-weight: bold;">
            <%= msg.message %>
        </div>

    </div>

<% }) %>



</div>







<div class="inputArea">


<input 
id="input"
type="text"
placeholder="Share your market view..."
>


<button id="send">

Send

</button>


</div>



</div>






<div class="users" id="users">


<h3>
Online Traders
</h3>


</div>





<script src="/socket.io/socket.io.js"></script>



<script>


const socket = io();


const username = "<%= user.username %>";



socket.emit("join",username);



const input=document.getElementById("input");

const send=document.getElementById("send");

const messages=document.getElementById("messages");

const users=document.getElementById("users");





send.onclick=()=>{


if(input.value.trim()=="")
return;



socket.emit("chat message",{

message:input.value

});


input.value="";


};





input.addEventListener("keypress",e=>{


if(e.key==="Enter")

send.click();


});






socket.on("chat message",data=>{


let div=document.createElement("div");


div.className="message";



div.innerHTML=`

<div class="name">

${data.username}

<span class="time">

${data.time}

</span>


</div>


<div class="text">

${data.message}

</div>


`;



messages.appendChild(div);


messages.scrollTop=messages.scrollHeight;


});







socket.on("online",list=>{


users.innerHTML="<h3>Online Traders</h3>";



list.forEach(name=>{


users.innerHTML+=`

<div class="user">

<div class="dot"></div>

${name}

</div>

`;


});


});






window.onload=()=>{

messages.scrollTop=messages.scrollHeight;

};


</script>




</body>

</html>