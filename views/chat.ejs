<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Premium Chat | BullChat</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">


<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Inter",sans-serif;
}

html{
height:100%;
}

body{
background:linear-gradient(180deg, #0D1117 0%, #10161f 100%);
color:#e6edf3;
height:100vh;
height:100dvh;
display:flex;
overflow:hidden;
}

/* Sidebar */

.sidebar{
width:240px;
background:#161B22;
border-right:1px solid #2D333B;
padding:22px;
display:flex;
flex-direction:column;
}

.logo{
font-size:22px;
font-weight:800;
margin-bottom:28px;
}

.logo span{
color:#2EA043;
}

.side-label{
font-size:11px;
font-weight:700;
letter-spacing:1.2px;
text-transform:uppercase;
color:#8b949e;
margin-bottom:10px;
}

.channel{
padding:14px 16px;
border-radius:10px;
background:linear-gradient(135deg, #238636, #2EA043);
color:#fff;
font-weight:600;
font-size:14px;
}

.side-link{
margin-top:auto;
padding:10px 14px;
border-radius:8px;
color:#8b949e;
text-decoration:none;
font-size:13px;
font-weight:600;
transition:all .2s ease;
}

.side-link:hover{
background:#21262d;
color:#e6edf3;
}

/* Chat */

.chat{
flex:1;
display:flex;
flex-direction:column;
min-width:0;
min-height:0;
overflow:hidden;
}

.header{
height:70px;
flex-shrink:0;
border-bottom:1px solid #2D333B;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 24px;
gap:16px;
}

.header-title h2{
font-size:18px;
font-weight:700;
}

.header-title .sub{
font-size:12px;
color:#8b949e;
}

.header-right{
display:flex;
align-items:center;
gap:14px;
}

.online{
display:flex;
align-items:center;
gap:8px;
font-size:13px;
color:#2EA043;
font-weight:600;
}

.online .pulse{
width:8px;
height:8px;
border-radius:50%;
background:#2EA043;
animation:pulse 1.6s infinite;
}

@keyframes pulse{
0%{box-shadow:0 0 0 0 rgba(46,160,67,.5)}
70%{box-shadow:0 0 0 8px rgba(46,160,67,0)}
100%{box-shadow:0 0 0 0 rgba(46,160,67,0)}
}

.theme-toggle{
padding:8px 16px;
font-size:13px;
font-weight:600;
color:#c9d1d9;
background:#21262d;
border:1px solid #2D333B;
border-radius:8px;
cursor:pointer;
transition:all .2s ease;
}

.theme-toggle:hover{
background:#30363d;
color:#fff;
}

/* Messages */

.messages{
flex:1;
min-height:0;
overflow-y:auto;
padding:24px;
}

.messages::-webkit-scrollbar{
width:6px;
}
.messages::-webkit-scrollbar-thumb{
background:#30363d;
border-radius:10px;
}

.date-chip{
text-align:center;
color:#8b949e;
font-size:12px;
font-weight:600;
margin:12px 0 20px;
}

.msg{
display:flex;
gap:10px;
margin-bottom:18px;
max-width:78%;
}

.msg.mine{
margin-left:auto;
flex-direction:row-reverse;
}

.msg-avatar{
width:36px;
height:36px;
border-radius:50%;
background:#21262d;
border:1px solid #2D333B;
display:flex;
align-items:center;
justify-content:center;
font-size:13px;
font-weight:700;
color:#2EA043;
flex-shrink:0;
}

.msg-avatar img{
width:36px;
height:36px;
border-radius:50%;
object-fit:cover;
}

.msg-body{
min-width:0;
}

.msg-meta{
display:flex;
align-items:center;
gap:8px;
margin-bottom:5px;
}

.msg.mine .msg-meta{
justify-content:flex-end;
}

.msg-name{
font-size:13px;
font-weight:700;
color:#e6edf3;
}

.msg-time{
font-size:11px;
color:#8b949e;
}

.msg-bubble{
display:inline-block;
padding:11px 15px;
border-radius:14px;
font-size:14px;
line-height:1.45;
word-break:break-word;
white-space:pre-wrap;
}

.msg.theirs .msg-bubble{
background:#21262d;
border:1px solid #2D333B;
border-top-left-radius:4px;
color:#e6edf3;
}

.msg.mine .msg-bubble{
background:linear-gradient(135deg, #238636, #2EA043);
color:#fff;
border-top-right-radius:4px;
box-shadow:0 4px 14px rgba(46,160,67,.25);
}

/* Input */

.inputArea{
display:flex;
align-items:center;
gap:12px;
flex-shrink:0;
padding:18px 24px;
border-top:1px solid #2D333B;
background:#161B22;
}

.inputArea input{
flex:1;
padding:14px 18px;
background:#0D1117;
border:1px solid #2D333B;
color:#e6edf3;
border-radius:12px;
outline:none;
font-size:14px;
transition:border-color .2s ease;
}

.inputArea input::placeholder{
color:#8b949e;
}

.inputArea input:focus{
border-color:#2EA043;
}

.inputArea button{
display:flex;
align-items:center;
gap:8px;
padding:14px 22px;
background:linear-gradient(135deg, #238636, #2EA043);
border:none;
color:#fff;
font-size:14px;
font-weight:700;
border-radius:12px;
cursor:pointer;
transition:all .2s ease;
box-shadow:0 4px 14px rgba(46,160,67,.25);
}

.inputArea button:hover{
transform:translateY(-1px);
box-shadow:0 6px 18px rgba(46,160,67,.35);
}

.inputArea button svg{
flex-shrink:0;
}

/* Users */

.users{
width:250px;
background:#161B22;
border-left:1px solid #2D333B;
padding:22px;
overflow-y:auto;
}

.users::-webkit-scrollbar{
width:6px;
}
.users::-webkit-scrollbar-thumb{
background:#30363d;
border-radius:10px;
}

.users .side-label{
margin-bottom:14px;
}

.user{
padding:10px 8px;
display:flex;
align-items:center;
gap:12px;
border-radius:10px;
transition:background .15s ease;
}

.user:hover{
background:#21262d;
}

.user .msg-avatar{
width:32px;
height:32px;
font-size:12px;
}

.user .msg-avatar img{
width:32px;
height:32px;
}

.user-name{
font-size:13px;
font-weight:600;
flex:1;
}

.user .status-dot{
width:8px;
height:8px;
border-radius:50%;
background:#2EA043;
}

.users-empty{
color:#8b949e;
font-size:13px;
padding:8px;
}

/* Light theme */

.light-theme{
background:#f5f7fa;
color:#111827;
}

.light-theme .sidebar,
.light-theme .users,
.light-theme .inputArea{
background:#ffffff;
border-color:#e5e7eb;
}

.light-theme .header,
.light-theme .inputArea{
border-color:#e5e7eb;
}

.light-theme .header-title h2,
.light-theme .msg-name{
color:#111827;
}

.light-theme .header-title .sub,
.light-theme .msg-time,
.light-theme .date-chip{
color:#6b7280;
}

.light-theme .msg-avatar{
background:#f0f2f5;
border-color:#e5e7eb;
}

.light-theme .msg.theirs .msg-bubble{
background:#f0f2f5;
border-color:#e5e7eb;
color:#111827;
}

.light-theme .inputArea input{
background:#f0f2f5;
border-color:#e5e7eb;
color:#111827;
}

.light-theme .theme-toggle{
background:#f0f2f5;
border-color:#e5e7eb;
color:#4b5563;
}

.light-theme .theme-toggle:hover{
background:#e5e7eb;
color:#111827;
}

.light-theme .side-link{
color:#6b7280;
}

.light-theme .side-link:hover{
background:#f0f2f5;
color:#111827;
}

.light-theme .user:hover{
background:#f0f2f5;
}

.light-theme .messages::-webkit-scrollbar-thumb,
.light-theme .users::-webkit-scrollbar-thumb{
background:#d1d5db;
}

/* Mobile */

@media(max-width:768px){

.sidebar{
display:none;
}

.users{
display:none;
}

.header{
padding:12px 16px;
}

.messages{
padding:16px;
}

.inputArea{
padding:12px 16px;
padding-bottom:calc(12px + env(safe-area-inset-bottom));
margin-bottom:10px;
gap:8px;
}

.msg{
max-width:90%;
}

.online .text{
display:none;
}

.theme-toggle{
padding:8px 12px;
font-size:12px;
}

.inputArea button{
padding:12px 14px;
}

}

@media (max-width:400px){

.header-title h2{
font-size:15px;
}

.header-title .sub{
display:none;
}

.msg{
max-width:95%;
}

.inputArea input{
padding:12px 14px;
font-size:13px;
}

}

</style>

</head>

<body>

<div class="sidebar">

<div class="logo">
Bull<span>Chat</span>
</div>

<div class="side-label">Channel</div>

<div class="channel">
# Premium Room
</div>

<a class="side-link" href="/dashboard">&larr; Back to Dashboard</a>

</div>

<div class="chat">

<div class="header">

<div class="header-title">
<h2>Premium Discussion</h2>
<div class="sub">NEPSE traders community</div>
</div>

<div class="header-right">

<div class="online">
<span class="pulse"></span>
<span class="text" id="onlineCount">0 Traders Online</span>
</div>

<button class="theme-toggle" id="themeToggle">Dark Mode</button>

</div>

</div>

<div class="messages" id="messages">

<!-- Old MongoDB Messages -->

<% messages.forEach(msg => { %>

    <div class="msg <%= msg.username === user.username ? 'mine' : 'theirs' %>">
        <div class="msg-avatar"><%= (msg.username || "?").slice(0,2).toUpperCase() %></div>
        <div class="msg-body">
            <div class="msg-meta">
                <span class="msg-name"><%= msg.username %></span>
                <span class="msg-time"><%= new Date(msg.createdAt).toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"}) %></span>
            </div>
            <div class="msg-bubble"><%= msg.message %></div>
        </div>
    </div>

<% }) %>

</div>

<div class="inputArea">

<input id="input" type="text" placeholder="Share your market view..." autocomplete="off">

<button id="send">
Send
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
</button>

</div>

</div>

<div class="users" id="users">

<div class="side-label">Online Traders</div>

<div class="users-empty">Connecting...</div>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const username = "<%= user.username %>";
const myAvatar = "<%= user.avatar ? '/uploads/' + user.avatar : '' %>";

const input = document.getElementById("input");
const send = document.getElementById("send");
const messages = document.getElementById("messages");
const users = document.getElementById("users");
const onlineCount = document.getElementById("onlineCount");

// Theme (matches dashboard behaviour)
function applyChatTheme() {
    if (localStorage.getItem("theme") === "light") {
        document.body.classList.add("light-theme");
        document.getElementById("themeToggle").textContent = "Dark Mode";
    } else {
        document.body.classList.remove("light-theme");
        document.getElementById("themeToggle").textContent = "Light Mode";
    }
}

document.getElementById("themeToggle").addEventListener("click", function () {
    document.body.classList.toggle("light-theme");

    const isLight = document.body.classList.contains("light-theme");

    localStorage.setItem("theme", isLight ? "light" : "dark");

    document.getElementById("themeToggle").textContent =
        isLight ? "Dark Mode" : "Light Mode";
});

applyChatTheme();

// Mobile: keep the input bar visible above the keyboard / browser bars
function syncViewportHeight() {
    if (window.visualViewport) {
        document.body.style.height = window.visualViewport.height + "px";
    }
}

if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", syncViewportHeight);
    window.visualViewport.addEventListener("scroll", syncViewportHeight);
}
syncViewportHeight();

// When the keyboard opens, make sure the input bar is scrolled into view
input.addEventListener("focus", () => {
    setTimeout(() => {
        syncViewportHeight();
        input.scrollIntoView({ block: "end" });
    }, 250);
});

socket.emit("join", username);

function avatarHTML(name, imgUrl) {
    const initials = String(name || "?").slice(0, 2).toUpperCase();

    return imgUrl
        ? `<img src="${imgUrl}" alt="">`
        : initials;
}

function createMessageHTML(data, mine) {
    const div = document.createElement("div");

    div.className = "msg " + (mine ? "mine" : "theirs");

    const imgUrl = mine && myAvatar ? myAvatar : "";

    div.innerHTML = `
        <div class="msg-avatar">${avatarHTML(data.username, imgUrl)}</div>
        <div class="msg-body">
            <div class="msg-meta">
                <span class="msg-name">${data.username}</span>
                <span class="msg-time">${data.time}</span>
            </div>
            <div class="msg-bubble"></div>
        </div>
    `;

    div.querySelector(".msg-bubble").textContent = data.message;

    return div;
}

send.onclick = () => {
    if (input.value.trim() === "") return;

    socket.emit("chat message", { message: input.value });

    input.value = "";
    input.focus();
};

input.addEventListener("keypress", e => {
    if (e.key === "Enter") send.click();
});

socket.on("chat message", data => {
    const mine = data.username === username;

    messages.appendChild(createMessageHTML(data, mine));
    messages.scrollTop = messages.scrollHeight;
});

socket.on("online", list => {
    onlineCount.textContent = list.length + " Trader" + (list.length === 1 ? "" : "s") + " Online";

    if (list.length === 0) {
        users.innerHTML = `<div class="side-label">Online Traders</div><div class="users-empty">No one online right now</div>`;
        return;
    }

    users.innerHTML = `<div class="side-label">Online Traders</div>` +
        list.map(name => `
            <div class="user">
                <div class="msg-avatar">${avatarHTML(name, "")}</div>
                <span class="user-name">${name}</span>
                <span class="status-dot"></span>
            </div>
        `).join("");
});

window.onload = () => {
    messages.scrollTop = messages.scrollHeight;
};

</script>

</body>

</html>
