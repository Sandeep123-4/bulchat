    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
    <title>Mudraaa - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="login-page">
    <div class="background-grid"></div>

    <div class="login-card">
        <div class="logo">
            <img class="logo-icon" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high" width="140" height="40" decoding="async">
            <h1>Mudraaa</h1>
        </div>

        <p class="subtitle">
            Premium stock market discussions and real-time trading chat.
        </p>

        <form action="/login" method="POST">
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
                <label>Password</label>
                <input type="password" name="password" placeholder="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" required />
            </div>

            <button type="submit" class="login-btn">Login</button>
        </form>

        <div class="footer">
            Don't have an account?
            <a href="/signup">Create one</a>
        </div>

        <div class="security">
            <span>Secure Cookie</span>
            <span>&bull;</span>
            <span>1 Hour Session</span>
        </div>
    </div>
</body>
</html>
