<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
    <title>BullChat - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Inter',sans-serif;
        }

        body{
            background:#0b0f17;
            color:#f5f7fa;
            min-height:100vh;
            height:auto;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:auto;
            padding:16px;
        }

        .background-grid{
            position:absolute;
            inset:0;
            background-image:
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size:40px 40px;
            mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
        }

        .login-card{
            position:relative;
            width:100%;
            max-width:380px;
            background:#121826;
            border:1px solid rgba(255,255,255,0.08);
            border-radius:20px;
            padding:36px 30px;
            box-shadow:0 20px 50px rgba(0,0,0,0.45);
            backdrop-filter: blur(8px);
        }

        .logo{
            display:flex;
            align-items:center;
            gap:12px;
            margin-bottom:28px;
            justify-content:center;
        }

        .logo-icon{
            width:42px;
            height:42px;
            border-radius:12px;
            background:#00c853;
            display:flex;
            align-items:center;
            justify-content:center;
            color:#06120a;
            font-weight:700;
            font-size:18px;
        }

        .logo h1{
            font-size:28px;
            font-weight:700;
            letter-spacing:-0.5px;
        }

        .logo span{
            color:#00c853;
        }

        .subtitle{
            text-align:center;
            color:#9ca3af;
            font-size:14px;
            margin-bottom:28px;
            line-height:1.5;
        }

        form{
            display:flex;
            flex-direction:column;
            gap:16px;
        }

        .field{
            display:flex;
            flex-direction:column;
            gap:8px;
        }

        .field label{
            font-size:13px;
            color:#d1d5db;
            font-weight:500;
        }

        .field input{
            width:100%;
            padding:14px 14px;
            border-radius:12px;
            border:1px solid #243045;
            background:#0f1522;
            color:#f5f7fa;
            outline:none;
            transition:border .2s ease, box-shadow .2s ease;
        }

        .field input::placeholder{
            color:#64748b;
        }

        .field input:focus{
            border-color:#00c853;
            box-shadow:0 0 0 3px rgba(0,200,83,0.15);
        }

        .login-btn{
            margin-top:6px;
            border:none;
            background:#00c853;
            color:#06120a;
            padding:14px;
            border-radius:12px;
            font-weight:700;
            font-size:15px;
            cursor:pointer;
            transition:transform .15s ease, opacity .2s ease;
        }

        .login-btn:hover{
            opacity:.95;
        }

        .login-btn:active{
            transform:translateY(1px);
        }

        .footer{
            margin-top:20px;
            text-align:center;
            font-size:13px;
            color:#9ca3af;
        }

        .footer a{
            color:#00c853;
            text-decoration:none;
            font-weight:600;
        }

        .security{
            margin-top:22px;
            display:flex;
            justify-content:center;
            gap:10px;
            font-size:12px;
            color:#64748b;
        }

        .security span{
            display:flex;
            align-items:center;
            gap:6px;
        }

        @media (max-width:420px){
            .login-card{
                margin:16px;
                padding:30px 22px;
            }
        }
    </style>
</head>
<body>
    <div class="background-grid"></div>

    <div class="login-card">
        <div class="logo">
            <div class="logo-icon">📈</div>
            <h1>Bull<span>Chat</span></h1>
        </div>

        <p class="subtitle">
            Premium stock market discussions and real-time trading chat.
        </p>

        <form action="/login" method="POST">
            <div class="field">
                <label>Email</label>
                <input type="email" name="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
                <label>Password</label>
                <input type="password" name="password" placeholder="••••••••" required />
            </div>

            <button type="submit" class="login-btn">Login</button>
        </form>

        <div class="footer">
            Don’t have an account?
            <a href="/signup">Create one</a>
        </div>

        <div class="security">
            <span>🔒 Secure Cookie</span>
            <span>•</span>
            <span>⏱ 1 Hour Session</span>
        </div>
    </div>
</body>
</html>