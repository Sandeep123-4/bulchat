<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | BullChat</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Inter,sans-serif;
}

body{
background:#0D1117;
color:#fff;
display:flex;
height:100vh;
overflow:hidden;
}

.sidebar{
width:190px;
background:#161B22;
border-right:1px solid #2D333B;
padding:25px;
}


.logo{
font-size:26px;
font-weight:700;
margin-bottom:45px;
}

.logo span{
color:#2EA043;
}

.menu a{
display:block;
padding:14px;
margin-bottom:10px;
border-radius:8px;
text-decoration:none;
color:#c9d1d9;
transition:.2s;
}


.menu a:hover{
background:#21262d;
color:#fff;
}

.main{
flex:1;
padding:35px;
overflow:auto;
}

.top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:35px;
}

.search{
box-shadow: 1px 1px 10px #ffffff;
width:820px;
padding:12px;
border:none;
outline:none;
border-radius:8px;
background:#161B22;
color:rgb(196, 191, 191);
}

.profile{
font-weight:600;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
margin-bottom:25px;
}

.card{
background:#161B22;
padding:25px;
border:1px solid #2D333B;
border-radius:12px;
}

.nepse-label {
    color: #faf9f9;
}

.card h3{
margin-bottom:10px;
font-size:18px;
}

.price{
font-size:30px;
font-weight:700;
color:#2EA043;
}

.buyCard{
background:#161B22;
padding:30px;
border-radius:12px;
border:1px solid #2D333B;
margin-top:20px;
}

button{
padding:14px 25px;
background:#2EA043;
border:none;
color:white;
font-size:16px;
border-radius:8px;
cursor:pointer;
}

button:hover{
background:#238636;
}
#searchResults {
    position: absolute;
    top: 100px;
    display: none;

    width: 100%;
    background: #232323;
    border: 1px solid #333;
    border-radius: 8px;

    max-height: 300px;
    overflow-y: auto;

    z-index: 9999;
}


#searchResults .search-item {
    padding: 10px 14px;
    color: white;
    cursor: pointer;
    border-bottom: 1px solid #222;
}

#searchResults .search-item:hover {
    background: #222;
}

.news{
margin-top:30px;
height: 660px;
background:#161B22;
padding:25px;
border-radius:12px;
border:1px solid #2D333B;
}
.click{
    width: 100%;
    height: 15%;
    background-color:#eeefef25 ;
    border-radius: 10px;
    display: flex;
    justify-content:flex-start;
    padding: 15px;
    align-items: center;
    gap: 10px;
}
.click button{
    background-color: #ececed39;
    width: 15%;
    height: 45px;
}
.click button:hover{
        background-color: #ffffff;
        color: #0D1117;   
}
.show{
    padding: 30px;
    display: inline;
}
.ide{
    display:flex;
    justify-content: space-between;
     background-color: #ffffff14;
     border-radius: 5px;

}
.ide  li{
      list-style: none !important;
     
}
.show {
    width: 100%;
    overflow-x: auto;
}

.ide {
    display: grid;
     background-color: #717774;
    grid-template-columns:
        100px
        100px
        100px
        130px
        120px
        100px
        100px
        100px
        100px;

    padding: 12px;
    border-bottom: 1px solid #333;
    min-width: 950px;
}

.header {
    font-weight: bold;
    background: #315abb;
}

.ide > div {
    padding: 0 8px;
}
.loser-row{
    background-color: red;
}
.gainer-row{
    background-color: rgb(31, 171, 9);
}


/* ===========================
   Responsive Design
=========================== */

@media (max-width: 1024px){

.cards{
    grid-template-columns:1fr 1fr;
}

}

@media (max-width:768px){

body{
    flex-direction:column;
}

/* Sidebar */

.sidebar{
    width:100%;
    height:auto;
    padding:15px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-right:none;
    border-bottom:1px solid #2D333B;
}

.menu{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.menu a{
    margin:0;
    padding:10px 14px;
}

/* Main */

.main{
    padding:20px;
}

/* Top */

.top{
    flex-direction:column;
    align-items:flex-start;
    gap:15px;
}

.search{
    width:100%;
}

/* Cards */

.cards{
    grid-template-columns:1fr;
}

.card{
    width:100%;
}

/* Buttons */

button{
    width:80%;
    margin-left: 20px;
}

}

/* Small Phones */

@media (max-width:480px){

    .sidebar{
    width:100%;
    height:auto;
    padding:1px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-right:none;
    border-bottom:1px solid #2D333B;
}

.logo{
    font-size:12px;
}

h2{
    font-size:15px;
}

.search{
    font-size:14px;
}

.card{
    padding:8px;
}

.price{
    font-size:24px;
    width: 30px;
}

}

#nepseIndex {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    display: block;
    margin-bottom: 4px;
}

/* Change percentage */
#changePercent {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #16a34a;
    margin-bottom: 20px;
}

/* Stats container */
#change,
#high,
#low {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;

    background: #f8fafc;
    border-radius: 9px;

    padding: 12px 14px;

    min-width: 90px;

    font-size: 14px;
    font-weight: 600;
    color: #374151;

    margin-right: 8px;
    margin-bottom: 8px;
}

/* Change */
#change {
    color: #2563eb;
}

/* High */
#high {
    color: #16a34a;
}

/* Low */
#low {
    color: #dc2626;
}

/* Mobile */
@media (max-width: 500px) {

    .nepse-card {
        padding: 16px;
    }

    #nepseIndex {
        font-size: 28px;
    }

    #change,
    #high,
    #low {
        min-width: 80px;
        padding: 10px;
    }
    .news{
margin-top:30px;
background:#161B22;
font-size: 11px;
padding:25px;
border-radius:12px;
border:1px solid #2D333B;
}
}

.showindexsub {
    width: 100%;
    overflow: hidden;
    position: relative;
}

.subindex-track {
    display: flex;
    width: max-content;
    gap: 35px;
    animation: slideSubindices 30s linear infinite;
}

.subindex-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 8px 0;
}

.subindex-name {
    font-weight: 600;
}

.subindex-value {
    font-weight: 500;
}

.subindex-change {
    font-size: 13px;
}

.positive {
    color: #16a34a;
}

.negative {
    color: #dc2626;
}
.subindex-track {
    animation: slideSubindices 90s linear infinite;
}

@keyframes slideSubindices {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }
}


</style>

</head>

<body>

<div class="sidebar">
<div class="menu">

<button onclick="location.href='/chat'">
    Chat Room
</button>
<a href="/logout">Logout</a>
</div>

</div>

<div class="main">

<div class="top">

<h2>Welcome, <%= user.username %></h2>

<input
class="search"
placeholder="stockSearch"
>

<div id="searchResults"></div>

<div id="activeStock"></div>

</div>

<div class="cards">

<div class="card">
<div id="nepseIndex">Loading...</div>
<div id="changePercent">Loading...</div>
<div id="change">Loading...</div>
<div id="high">Loading...</div>
<div id="low">Loading...</div>

</div>

<div class="card">
<h3>Members Online</h3>
<div class="price">184</div>
<p>Currently active traders.</p>
</div>

<div class="card">
<h3>Subscription</h3>
<div class="price">
<%= user.premium ? "Premium" : "Free" %>
</div>
<p>Upgrade for full access.</p>
</div>

</div>
<div class="buyCard  showindexsub">

</div>

<div class="buyCard">

<h2>Premium Trading Chat</h2>

<p style="margin-top:10px;color:#9BA3AF;">
Access exclusive market discussions, trading signals,
daily analysis and premium community.
</p>

<% if(!user.premium){ %>

<button>
Buy Premium
</button>

<% }else{ %>

<button onclick="location.href='/chat'">
Enter Chat Room
</button>

<% } %>

</div>

<div class="news">
   <div class="click">
    <button
    id="Gainer" >Gainers</button>
    <button
    id="Loser" >Losers</button>
    <button
    id="turnover" >turnover</button>
    <button
    id="volume" >volume</button>
   </div>
   <div class="show">
    <div class="ide">
       <div>Symbol</div>
        <div>LTP</div>
        <div>% Chg</div>
        <div>point</div>
        <div>Turnover</div>
        <div>Volume</div>
        <div>Open</div>
        <div>Close</div>
        <div>previous</div>
    </div>
       <div id="topGainersTable"></div>
        <div id="topLosersTable"></div>
    
   </div>

</div>
<script>
async function fetchNepseIndex() {
    try {
        const response = await fetch('/api/nepse-index');

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
       
const nindex =document.getElementById("nepseIndex");
nindex.innerHTML =
    '<span class="nepse-label">Nepse: </span>' +
    Number(data.previousClose).toFixed(2);

const changepercentage =  document.getElementById("changePercent");
const change =  document.getElementById("change");

        if(data.previousClose<data.index){
nindex.style.color = "#FF0000"
changepercentage.textContent =Number(-data.changePercent).toFixed(2)+ "%";
changepercentage.style.color = "#FF0000"
change.textContent = Number(-data.change).toFixed(2);
change.style.color = "#FF0000"
}
else{
nindex.style.color = "#FF0000"
changepercentage.textContent =Number(data.changePercent).toFixed(2)+ "%";
changepercentage.style.color = "#32CD32"
change.textContent = Number(data.change).toFixed(2);
change.style.color = "#32CD32"

}




document.getElementById("high").textContent =
       Number(data.high).toFixed(2);

document.getElementById("low").textContent =
        Number(data.low).toFixed(2);

 

    } catch (error) {
        console.error("NEPSE API ERROR:", error);
    }
}

async function fetchTopGainers() {
    try {
        const response = await fetch('/api/top-gainers');
        const response1 = await fetch('/api/TradeTurnoverTransactionSubindices');

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
         const data1 = await response1.json();
        const top10 = data.slice(0, 10);

        const allStocks = data1.scripsDetails || {};

const scripsDetails = {};

top10.forEach(topStock => {
    const symbol = String(topStock.symbol).trim().toUpperCase();

    scripsDetails[symbol] =
        allStocks[symbol] || topStock;
});



const table = document.getElementById("topGainersTable");

table.innerHTML = "";

top10.forEach(stock => {

    const row = document.createElement("div");
     const detail = scripsDetails[stock.symbol] || {};

    row.className = "ide gainer-row";

    row.innerHTML = `
        <div>${stock.symbol}</div>
        <div>${Number(stock.ltp).toFixed(2)}</div>
        <div>${Number(stock.percentageChange).toFixed(2)}%</div>
        <div>+${Number(stock.pointChange).toFixed(2)}</div>
        <div>${Number(detail.Turnover ?? 0).toLocaleString()}</div>
        <div>${Number(detail.volume ?? 0).toLocaleString()}</div>
        <div>${Number(stock.ltp-stock.pointChange ?? 0).toFixed(2)}</div>
        <div>${Number(stock.cp).toFixed(2)}</div>
        <div>${Number(detail.previousClose ?? 0).toFixed(2)}</div>

    `;

    table.appendChild(row);

});



    } catch (error) {
        console.error("NEPSE API ERROR:", error);
    }
}

async function fetchTopLosers() {

    try {

        const response = await fetch('/api/top-losers');
        const response1 = await fetch('/api/TradeTurnoverTransactionSubindices');

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
        const data1 = await response1.json();

        
        const top10 = data.slice(0, 10);
        const table = document.getElementById("topLosersTable");
const allStocks = data1.scripsDetails || {};

const scripsDetails = {};

top10.forEach(topStock => {
    const symbol = String(topStock.symbol).trim().toUpperCase();

    scripsDetails[symbol] =
        allStocks[symbol] || topStock;
});


        // Clear gainers
        document.getElementById("topGainersTable").innerHTML = "";

        // Clear previous losers
        table.innerHTML = "";

        top10.forEach(stock => {

            const row = document.createElement("div");

            row.className = "ide loser-row";
            const detail = scripsDetails[stock.symbol] || {};
            

            row.innerHTML = `

                <div>${stock.symbol || "-"}</div>

                <div>
                    ${Number(
                        stock.ltp ??
                        stock.close ??
                        stock.lastTradedPrice ??
                        0
                    ).toFixed(2)}
                </div>

                <div>
                    ${Number(
                        stock.percentageChange ??
                        stock.changePercent ??
                        stock.percentChange ??
                        0
                    ).toFixed(2)}%
                </div>

                  <div>${Number(stock.pointChange).toFixed(2)}</div>

                <div>
            ${Number(
                detail.Turnover ?? 
                detail.turnover ?? 
                0
            ).toLocaleString()}
                 </div>

                <div>
                    ${Number(
                        detail.volume ?? 0
                    ).toLocaleString()}
                </div>

                <div>
                    ${Number(
                        stock.ltp-stock.pointChange ?? 0
                    ).toFixed(2)}
                </div>

                <div>
                    ${Number(
                        stock.cp ??
                        stock.close ??
                        0
                    ).toFixed(2)}
                </div>

                <div>
                    ${Number(
                        detail.previousClose ?? 0
                    ).toFixed(2)}
                </div>



            `;

            table.appendChild(row);

        });

    } catch (error) {

        console.error("NEPSE API ERROR:", error);

    }
}


async function fetchCompanyList() {

    
const search = document.querySelector(".search");
const searchInput = document.getElementById("stockSearch");
const searchResults = document.getElementById("searchResults");
const activeStock = document.getElementById("activeStock");

search.addEventListener("input", async (event) => {
 searchResults.style.display = "block";
    const query = event.target.value
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ");

    if (!query) {
        searchResults.innerHTML = "";
        return;
    }

    try {
        const response = await fetch("/api/CompanyList");

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const companies = await response.json();

        const results = companies.filter(stock => {
            const name = String(          
                stock.symbol ||stock.securityName||
                ""
            )
            .toLowerCase();

            // Allows multiple words
            return query
                .split(" ")
                .every(word => name.includes(word));
        });

  searchResults.innerHTML = results
.map(stock => `
    <div class="search-item" data-symbol="${stock.symbol}">
        ${stock.symbol}
    </div>
`)
.join("");

document.querySelectorAll(".search-item").forEach(item => {

    item.addEventListener("click", () => {

        const symbol = item.dataset.symbol;

        window.location.href =
            `/stock/${encodeURIComponent(symbol)}`;

    });

});

    } catch (error) {
        console.error("Search error:", error);
    }
});



        

}

async function fetchSubIndices() {
    try {
        const response = await fetch("/api/NepseSubIndices");

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
           const subindices = Object.values(data);

        const containers = document.querySelectorAll(".showindexsub");

        containers.forEach(container => {
            container.innerHTML = "";

            // Create sliding track
            const track = document.createElement("div");
            track.className = "subindex-track";

            // Add indices twice for seamless infinite scrolling
            const items = [...subindices, ...subindices];

            items.forEach(index => {

                const item = document.createElement("div");
                
                item.className = "subindex-item";

                const name =
                    index.index ??
                    index.name ??
                    index.indexName ??
                    "-";

                const value =
                    index.value ??
                    index.close ??
                    index.currentValue ??
                    0;

                const change =
                    index.percentageChange ??
                    index.changePercent ??
                    index.perChange ??
                    0;

                const pointChange =
                    index.pointChange ??
                    index.change ??
                    0;

                item.innerHTML = `
                    <span class="subindex-name">
                        ${name}
                    </span>

                    <span class="subindex-value">
                        ${Number(value).toFixed(2)}
                    </span>

                    <span class="subindex-change ${Number(change) >= 0 ? "positive" : "negative"}">
                        ${Number(pointChange).toFixed(2)}
                        (${Number(change).toFixed(2)}%)
                    </span>
                `;

                track.appendChild(item);
            });

            container.appendChild(track);
        });

    } catch (error) {
        console.error("Subindices error:", error);
    }
}

fetchSubIndices();

const Gainer = document.getElementById("Gainer");
const Loser = document.getElementById("Loser");
const turnover = document.getElementById("turnover");
const volume = document.getElementById("volume");
const gainersTable = document.getElementById("topGainersTable");
const losersTable = document.getElementById("topLosersTable");

fetchNepseIndex();
fetchCompanyList();

Gainer.addEventListener("click", () => {
losersTable.innerHTML = "";
fetchTopGainers();
});

Loser.addEventListener("click", () => {
     gainersTable.innerHTML = "";
    fetchTopLosers();
});


setInterval(fetchNepseIndex, 10000);
</script>
</body>
</html>