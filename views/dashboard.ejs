                        stock.changePercent ??
                        stock.percentChange ??
                        0
                    ).toFixed(2)}%
                </div>

                  <div>${Number(stock.pointChange).toFixed(2)}</div>

                <div>
            ${Number(
                detail.Turnover ?? 
                detail.turnover ?? 
                0
            ).toLocaleString()}
                 </div>

                <div>
                    ${Number(
                        detail.volume ?? 0
                    ).toLocaleString()}
                </div>

                <div>
                    ${Number(
                        stock.ltp-stock.pointChange ?? 0
                    ).toFixed(2)}
                </div>

                <div>
                    ${Number(
