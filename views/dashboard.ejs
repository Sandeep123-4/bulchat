<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
<title>Dashboard | Mudraaa</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

<div class="main">
<div class="top">
    <div class="brand">
        <img class="brand-logo" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high">
        <div>
            <h2><span data-i18n="welcome">Welcome,</span> <%= user.username %></h2>
            <span class="top-sub" data-i18n="topSub">Here's your market overview</span>
        </div>
    </div>
    <div class="search-wrap">
        <input class="search" placeholder="Search stocks..." >
        <div id="searchResults"></div>
    </div>
    <div class="controls">
        <button id="langBtn" class="ctrl-btn" title="Language">नेपाली</button>
        <button id="themeBtn" class="ctrl-btn" title="Theme">Dark Mode</button>
    </div>
</div>

<div id="activeStock"></div>

<div class="cards">

<div class="card nepse-card">
    <div class="card-title" data-i18n="marketOverview">Market Overview</div>
    <div id="nepseIndex">Loading...</div>
    <div id="changePercent">Loading...</div>
    <div class="stats-grid">
        <div class="stat">
            <span class="stat-label" data-i18n="statChange">Change</span>
            <span class="stat-value" id="change">-</span>
        </div>
        <div class="stat">
            <span class="stat-label" data-i18n="statHigh">Day High</span>
            <span class="stat-value" id="high">-</span>
        </div>
        <div class="stat">
            <span class="stat-label" data-i18n="statLow">Day Low</span>
            <span class="stat-value" id="low">-</span>
        </div>
    </div>
    <div class="global-ticker" id="globalTicker">
        <div class="ticker-item">
            <span class="ticker-icon gold">Au</span>
            <div class="ticker-info">
                <span class="ticker-label">Gold/तोला</span>
                <span class="ticker-price" id="goldPrice">--</span>
            </div>
            <span class="ticker-change" id="goldChange">--</span>
        </div>
    </div>
</div>

<div class="card profile-card">
    <div class="card-title" data-i18n="yourProfile">Your Profile</div>
    <div class="profile-body">
        <div class="profileimg">
            <img id="profileAvatar" src="<%= user.avatar ? '/uploads/' + user.avatar : '/img/profile.png' %>" alt="Profile">
            <div class="avatar-overlay" id="avatarOverlay">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                    <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span data-i18n="changePhoto">Change photo</span>
            </div>
            <input type="file" id="avatarInput" accept="image/*" hidden>
        </div>
        <div class="profileinfo">
            <div class="name" id="nameDisplay">
                <span id="usernameText"><%= user.username %></span>
                <button id="edityourname" data-i18n="edit">edit</button>
            </div>
            <hr>
            <div class="displayemail">
                <span><%= user.email %></span>
            </div>
            <div class="premium">
                <span data-i18n="premium">Premium:  </span>
                <% if(user.premium){ %>
                    <span style="color: #16a34a;" data-i18n="premiumActive"> active</span>
                <% } else { %>
                    <span data-i18n="premiumInactive">not active</span>
                <% } %>
            </div>
            <% if(!user.premium){ %>
            <div class="buypremiumcard">
                <button id="buyPremium" data-i18n="activate">activate</button>
                <span data-i18n="premiumText">enjoy free suggestions from chat</span>
            </div>
            <% } %>
        </div>
    </div>
</div>

<div class="card quick-card">
    <div class="card-title" data-i18n="quickTitle">Quick Actions</div>
    <button onclick="location.href='/chat'" data-i18n="chatRoom">
        Chat Room
    </button>
    <button onclick="location.href='/commodities'" data-i18n="commodities">
        Commodities
    </button>
    <button onclick="location.href='/crypto'" data-i18n="crypto">
        Crypto
    </button>
</div>

<div class="card index-chart-card">
    <div class="card-title" data-i18n="chartTitle">NEPSE Index Trend</div>
    <div class="index-chart-wrap">
        <canvas id="indexChart"></canvas>
    </div>
</div>

</div>

<div class="section">
    <div class="section-title" data-i18n="subIndices">Sub-indices</div>
    <div class="buyCard  showindexsub"></div>
</div>

<div class="news">
    <div class="news-head">
        <span class="section-title" data-i18n="marketMovers">Market Movers</span>
    </div>
   <div class="click">
    <button
    id="Gainer" data-i18n="gainers" >Gainers</button>
    <button
    id="Loser" data-i18n="losers" >Losers</button>
    <button
    id="turnover" data-i18n="turnover" >turnover</button>
    <button
    id="volume" data-i18n="volume" >volume</button>
   </div>
   <div class="show">
    <div class="ide header">
       <div data-i18n="symbol">Symbol</div>
        <div>LTP</div>
        <div data-i18n="pctChg">% Chg</div>
        <div data-i18n="point">point</div>
        <div data-i18n="turnoverHdr">Turnover</div>
        <div data-i18n="volumeHdr">Volume</div>
        <div data-i18n="open">Open</div>
        <div data-i18n="close">Close</div>
        <div data-i18n="previous">previous</div>
    </div>
       <div id="topGainersTable"></div>
        <div id="topLosersTable"></div>
    
   </div>

</div>

<div class="section subindices-details">
    <div class="section-title" data-i18n="allSubIndices">All Sub-indices Details</div>
    <div class="news">
        <div class="show">
            <div class="ide header sub-ide">
                <div data-i18n="index">Index</div>
                <div data-i18n="value">Value</div>
                <div data-i18n="pointChange">Point Change</div>
                <div data-i18n="pctChange">% Change</div>
            </div>
            <div id="subindicesTable"></div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/notifications.js"></script>
<script src="/js/chart.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
