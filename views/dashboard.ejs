<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | BullChat</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family: "Inter", sans-serif;
}

body{
background: linear-gradient(180deg, #0D1117 0%, #10161f 100%);
color:#fff;
display:flex;
height:100vh;
overflow:hidden;
}



.logo{
font-size:26px;
font-weight:700;
margin-bottom:45px;
}

.logo span{
color:#2EA043;
}

.menu a{
display:block;
padding:14px;
margin-bottom:10px;
border-radius:8px;
text-decoration:none;
color:#c9d1d9;
transition:.2s;
}


.menu a:hover{
background:#21262d;
color:#fff;
}

.main{
flex:1;
padding:15px;
overflow:auto;
width:100%;
max-width:1200px;
margin:0 auto;
}

.top{
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
margin-bottom:20px;
}

.controls{
    display:flex;
    gap:10px;
    flex-shrink:0;
}
.ctrl-btn{
    padding:10px 18px !important;
    font-size:13px !important;
    font-weight:600 !important;
    background:#21262d !important;
    border:1px solid #2D333B !important;
    color:#c9d1d9 !important;
    border-radius:8px;
    cursor:pointer;
    white-space:nowrap;
}
.ctrl-btn:hover{
    background:#30363d !important;
    color:#fff !important;
}
.light-theme .ctrl-btn{
    background:#f0f2f5 !important;
    border-color:#e5e7eb !important;
    color:#4b5563 !important;
}
.light-theme .ctrl-btn:hover{
    background:#e5e7eb !important;
    color:#111827 !important;
}

.brand{
    display:flex;
    align-items:center;
    gap:14px;
}

.avatar{
    width:46px;
    height:46px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    font-size:16px;
    color:#fff;
    background:linear-gradient(135deg, #238636, #2EA043);
    box-shadow: 0 4px 14px rgba(46,160,67,0.35);
    flex-shrink:0;
}

.top-sub{
    font-size:13px;
    color:#8b949e;
}

.search-wrap{
    position:relative;
    flex:1;
    max-width:480px;
    margin-left:auto;
}

.search{
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    width:100%;
    padding:12px 16px;
    outline:none;
    border-radius:10px;
    background:#161B22;
    color:rgb(196, 191, 191);
    transition: border-color .2s ease;
}

.profile{
font-weight:600;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
margin-bottom:5px;
align-items:start;
}

.card{
background:#161B22;
padding:18px;
border: 1px solid #2D333B;
box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
border-radius:14px;
}
.index-chart-card{
    grid-column: 1 / -1;
}
.index-chart-card .index-chart-wrap{
    height: 320px;
}
.index-chart-wrap{
    margin-top: 16px;
    height: 220px;
    position: relative;
}
.index-chart-wrap canvas{
    width: 100% !important;
    height: 100% !important;
}
.profile-card{
    display: flex;
    flex-direction: column;
}
.profile-body{
    display: flex;
    gap: 14px;
    flex: 1;
}
.profileimg {
    width: 38%;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    background:#21262d;
    flex-shrink: 0;
}
.profileimg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    max-width: none;
    max-height: none;
}
.avatar-overlay{
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    opacity: 0;
    cursor: pointer;
    transition: opacity .2s ease;
}
.profileimg:hover .avatar-overlay{
    opacity: 1;
}
.profileinfo{
background-color: #eff1f315;
width: 62%;
border-radius: 10px;
display: flex;
flex-direction: column;
gap: 6px;
padding: 12px;
}
.name{
    width: 100%;
    font-size: 1.2vw;
    font-weight: 600;
    display:flex;
    justify-content: space-between;
    align-items: center;
    padding: 1px;
}
.name button{
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    background:#2EA043;
}
.name button:hover{
    background:#238636;
}
.displayemail{
    padding: 1px;
    padding-left: 5px;
    font-size: 13px;
    color:#8b949e;
    word-break: break-word;
}
.premium{
    display: flex;
    gap: 5px;
    padding-left: 5px;
    font-size: 13px;
}
.premium span:nth-child(2) {
    color: #dc2626;
    padding-left: 5px;
}
.quick-card{
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.quick-card button{
    width: 100%;
    padding: 14px;
    font-size: 14px;
    font-weight: 600;
}
.quick-card #theme{
    background: #21262d;
    border: 1px solid #2D333B;
    color: #c9d1d9;
}
.quick-card #theme:hover{
    background: #30363d;
    color: #fff;
}

.section{
    margin-top: 24px;
}
.section-title{
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: #e6edf3;
    margin-bottom: 12px;
    padding-left: 2px;
}
.news-head{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}
.news-head .section-title{
    margin-bottom: 0;
}
.buypremiumcard{
    margin-top: 4px;
    display: flex;
    gap: 6px;
    padding-left: 5px;
}
.buypremiumcard span{
    font-size: 13px;
    color: #09cd10;
}


.nepse-label {
    color: #faf9f9;
}

.card h3{
margin-bottom:10px;
font-size:18px;
}

.price{
font-size:30px;
font-weight:700;
color:#2EA043;
}

.buyCard{
background:#161B22;
padding:30px;
border-radius:12px;
border: 1px solid #2D333B;
box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
margin-top:20px;
}

button{
padding:14px 25px;
background:#2EA043;
border:none;
color:white;
font-size:1.1vw;
border-radius:8px;
cursor:pointer;
}

button:hover{
background:#238636;
}
#searchResults {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    display: none;
    background: #161B22;
    border: 1px solid #2D333B;
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    max-height: 380px;
    overflow-y: auto;
    z-index: 9999;
    padding: 6px;
}

#searchResults::-webkit-scrollbar {
    width: 6px;
}
#searchResults::-webkit-scrollbar-thumb {
    background: #30363d;
    border-radius: 10px;
}

.search-results-head {
    padding: 10px 14px 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #8b949e;
}

#searchResults .search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 8px;
    cursor: pointer;
    transition: background .15s ease;
}

#searchResults .search-item:hover,
#searchResults .search-item.active {
    background: #21262d;
}

.s-item-symbol {
    min-width: 78px;
    font-weight: 700;
    font-size: 14px;
    color: #e6edf3;
}

.s-item-symbol .hl {
    color: #2EA043;
}

.s-item-name {
    flex: 1;
    font-size: 13px;
    color: #8b949e;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.s-item-name .hl {
    color: #e6edf3;
}

.s-item-sector {
    font-size: 11px;
    font-weight: 600;
    color: #2EA043;
    background: rgba(46, 160, 67, 0.12);
    border-radius: 20px;
    padding: 3px 10px;
    white-space: nowrap;
}

.search-empty {
    padding: 22px 16px;
    text-align: center;
    color: #8b949e;
    font-size: 14px;
}

.showindexsub {
    width: 100%;
    overflow: hidden;
    position: relative;
}

.subindex-track {
    display: flex;
    width: max-content;
    gap: 35px;
    animation: slideSubindices 60s linear infinite;
}

.subindex-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 1px 0;
}

.subindex-name {
    font-weight: 600;
}

.subindex-value {
    font-weight: 500;
}

.subindex-change {
    font-size: 13px;
}

.positive {
    color: #16a34a;
}

.negative {
    color: #dc2626;
}
.subindex-track {
    animation: slideSubindices 90s linear infinite;
}

.news{
margin-top:10px;
background:#161B22;
padding:15px;
border-radius:12px;
border: 1px solid #2D333B;
box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}
.click{
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #2D333B;
    border-radius: 12px;
    overflow-x: auto;
}
.click button{
    flex: 1;
    min-width: 90px;
    height: 42px;
    padding: 0 18px;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #8b949e;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s ease;
    text-transform: capitalize;
}
.click button:hover{
    background: rgba(255, 255, 255, 0.08);
    color: #e6edf3;
}
.click button.active{
    background: linear-gradient(135deg, #238636, #2EA043);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(46, 160, 67, 0.35);
}
.show{
    padding: 18px 2px;
    width: 100%;
    display: inline;
}
.ide{
    width: 100%;
    display:flex;
    justify-content: space-between;
     background-color: #ffffff14;
     border-radius: 5px;

}
.ide  li{
      list-style: none !important;
     
}
.show {
    width: 100%;
    overflow-x: auto;
}

.ide {
    display: grid;
    background-color: #161B22;
    grid-template-columns:
        100px
        100px
        100px
        130px
        120px
        100px
        100px
        100px
        100px;

    padding: 12px;
    border-bottom: 1px solid #2D333B;
    min-width: 950px;
    font-size: 14px;
    align-items: center;
}

.ide.header {
    background: #21262d;
    color: #8b949e;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #2EA043;
    border-radius: 10px 10px 0 0;
}

.ide.sub-ide {
    grid-template-columns: repeat(4, 1fr);
    min-width: 0;
}

.subindices-details .news{
    margin-top: 0;
    padding: 0;
}

.subindices-details .ide:last-child {
    border-bottom: none;
    border-radius: 0 0 10px 10px;
}

.ide > div {
    padding: 0 8px;
}
.loser-row{
    background: rgba(248, 81, 73, 0.08);
    color: #e6edf3;
    transition: background .2s ease;
}
.loser-row:hover{
    background: rgba(248, 81, 73, 0.18);
}
.gainer-row{
    background: rgba(46, 160, 67, 0.08);
    color: #e6edf3;
    transition: background .2s ease;
}
.gainer-row:hover{
    background: rgba(46, 160, 67, 0.18);
}

.ide.clickable-row{
    cursor: pointer;
    transition: background .2s ease;
}

.ide.clickable-row:not(.gainer-row):not(.loser-row):hover{
    background: rgba(255, 255, 255, 0.06);
}
.card-title{
    font-size: 13px;
    font-weight: 600;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 14px;
}

#nepseIndex {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    display: block;
    margin-bottom: 6px;
}

/* Change percentage */
#changePercent {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(22, 163, 74, 0.12);
    color: #16a34a;
    margin-bottom: 18px;
}

/* Stats grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid #2D333B;
    border-radius: 10px;
    padding: 12px;
    transition: border-color .2s ease;
}

.stat-label {
    font-size: 11px;
    font-weight: 600;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.stat-value {
    font-size: 18px;
    font-weight: 700;
    color: #e6edf3;
}

/* Change */
#change {
    color: #e6edf3;
}

/* High */
#high {
    color: #16a34a;
}

/* Low */
#low {
    color: #dc2626;
}



@keyframes slideSubindices {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }
}

/* ===========================
   Responsive Design
=========================== */

@media (max-width: 1024px){

.cards{
    grid-template-columns:1fr 1fr;
}

}

@media (max-width:768px){

body{
    flex-direction:column;
}

/* Sidebar */
#topGainersTable{
    width: 100%;
}

.sidebar{
    width:100%;
    height:auto;
    padding:15px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-right:none;
    border-bottom:1px solid #2D333B;
}

.menu{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.menu a{
    margin:0;
    padding:10px 14px;
}

/* Main */

.main{
    padding:20px;
}

/* Top */

.top{
    flex-direction:column;
    align-items:flex-start;
    gap:15px;
}

.search-wrap{
    max-width:100%;
    width:100%;
    margin-left:0;
}

.search{
    width:100%;
}

/* Touch devices: always show the avatar overlay */
.avatar-overlay{
    opacity: 1;
}

/* Cards */

.cards{
    grid-template-columns:1fr;
}

.card{
    width:100%;
}

/* Buttons */

.click button{
    flex:1;
}

}

/* Small Phones */

@media (max-width:480px){

    .sidebar{
    width:100%;
    height:auto;
    padding:1px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-right:none;
    border-bottom:1px solid #2D333B;
}

.main{
    padding:14px;
}

.logo{
    font-size:12px;
}

h2{
    font-size:15px;
}

.search{
    font-size:14px;
}

.card{
    padding:12px;
}

.card-title{
    font-size:12px;
}

.avatar{
    width:38px;
    height:38px;
    font-size:14px;
}

.profile-body{
    flex-direction:column;
    gap:12px;
}

.profileimg{
    width:100%;
    aspect-ratio:16/9;
}

.profileinfo{
    width:100%;
}

.name{
    font-size:15px;
}

.quick-card button{
    padding:12px;
    font-size:13px;
}

}

/* Mobile */
@media (max-width: 500px) {

    .nepse-card {
        padding: 16px;
    }

    #nepseIndex {
        font-size: 28px;
    }

    .stats-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .stat {
        padding: 10px;
    }

    .stat-value {
        font-size: 15px;
    }
    .news{
margin-top:30px;
background:#161B22;
font-size: 11px;
padding:25px;
border-radius:12px;
border:1px solid #2D333B;
}

.name{
    width: 100%;
    font-size: 14px;
    display:flex;
    justify-content: space-between;
    padding: 1px;
}
.name button{
    width: 30px;
    padding: 5px;
    border-radius: 3px;
}

.show .ide {
    grid-template-columns: 1fr 1fr 1fr 1fr;
    min-width: 0;
    font-size: 12px;
}

.show .ide > div:nth-child(n+5) {
    display: none;
}

#topGainersTable{
    width: 100%;
}
}

/* Very small phones */
@media (max-width:360px){

.top-sub{
    display:none;
}

.stats-grid{
    gap:6px;
}

.stat{
    padding:8px;
}

.stat-value{
    font-size:13px;
}

.brand .avatar{
    width:34px;
    height:34px;
    font-size:13px;
}

.news{
    padding:14px;
}

.click button{
    min-width:78px;
    font-size:13px;
    height:38px;
}

}

.light-theme {
    background: #f5f7fa;
    color: #111827;
}
.light-theme .nepse-label{
      color: #111827;
}
.light-theme .click{
    background: #f0f2f5;
    border: 1px solid #e5e7eb;
}
.light-theme .click button{
    color: #4b5563;
     background: transparent;
}
.light-theme .click button:hover{
    background: #e5e7eb;
    color: #111827;
}
.light-theme .click button.active{
    background: #2EA043;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(46, 160, 67, 0.35);
}

.light-theme .sidebar,
.light-theme .card,
.light-theme .news,
.light-theme .search ,
.light-theme .buyCard {
    background: #ffffff;
    color: #111827;
    border: none;
    box-shadow: 1px 1px 10px rgb(241, 240, 240);
}

.light-theme .main {
    background: #f5f7fa;
}

.light-theme .card-title,
.light-theme .stat-label,
.light-theme .top-sub {
    color: #6b7280;
}

.light-theme .section-title {
    color: #111827;
}

.light-theme .stat {
    background: #ffffff;
    border-color: #e5e7eb;
}

.light-theme #nepseIndex {
    color: #111827;
}

.light-theme #change {
    color: #111827;
}

.light-theme .profileinfo,
.light-theme .profileimg {
    background: #f0f2f5;
}

.light-theme .displayemail {
    color: #4b5563;
}

.light-theme .quick-card #theme {
    background: #f0f2f5;
    border-color: #e5e7eb;
    color: #4b5563;
}
.light-theme .quick-card #theme:hover {
    background: #e5e7eb;
    color: #111827;
}

.light-theme .name button {
    background: #2EA043;
}
.light-theme .name button:hover {
    background: #238636;
}

.light-theme #searchResults {
    background: #ffffff;
    border-color: #e5e7eb;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
}
.light-theme .search-results-head,
.light-theme .s-item-name {
    color: #6b7280;
}
.light-theme #searchResults .search-item:hover,
.light-theme #searchResults .search-item.active {
    background: #f0f2f5;
}
.light-theme .s-item-symbol {
    color: #111827;
}
.light-theme .s-item-sector {
    color: #2EA043;
    background: rgba(46, 160, 67, 0.12);
}

.light-theme .ide {
    background: #ffffff;
    color: #111827;
}
.light-theme .ide.header {
    background: #f0f2f5;
    color: #4b5563;
    border-bottom: 2px solid #2EA043;
}
.light-theme .gainer-row {
    background: rgba(46, 160, 67, 0.10);
    color: #111827;
}
.light-theme .gainer-row:hover {
    background: rgba(46, 160, 67, 0.20);
}
.light-theme .loser-row {
    background: rgba(248, 81, 73, 0.10);
    color: #111827;
}
.light-theme .loser-row:hover {
    background: rgba(248, 81, 73, 0.20);
}




</style>

</head>

<body>

<div class="main">
<div class="top">
    <div class="brand">
        <div class="avatar">BS</div>
        <div>
            <h2><span data-i18n="welcome">Welcome,</span> <%= user.username %></h2>
            <span class="top-sub" data-i18n="topSub">Here's your market overview</span>
        </div>
