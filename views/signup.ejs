<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1684472482346109"
     crossorigin="anonymous"></script>
<title>Sign Up | Mudraaa</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/auth.css">

</head>
<body class="signup-page">

<div class="card">

<div class="logo">
<img class="logo-icon" src="/img/logo.svg" alt="Mudraaa" fetchpriority="high">
Mudraaa
</div>

<div class="subtitle">
Create your account
</div>

<form action="/signup" method="POST">

<input
type="text"
name="username"
placeholder="Username"
required>

<input
type="email"
name="email"
id="emailInput"
placeholder="Email"
required>

<div class="email-status" id="emailStatus"></div>

<input
type="password"
name="password"
placeholder="Password"
required>

<button>Create Account</button>

</form>

<div class="bottom">
Already have an account?
<a href="/login">Login</a>
</div>

</div>

<script src="/js/auth.js"></script>

</body>
</html>
