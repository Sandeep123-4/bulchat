    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broadcast Email | Mudraaa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/base.css">
    <style>
        :root {
            --bg: #0a0e17;
            --surface: #0d1117;
            --card: #161b22;
            --border: #21262d;
            --border-hover: #30363d;
            --text: #e1e4e8;
            --text-bright: #fff;
            --text-muted: #7d8590;
            --text-dim: #484f58;
            --green: #2EA043;
            --green-dark: #238636;
        }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: "Inter", sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 40px 20px;
        }
        .container {
            width: 100%;
            max-width: 720px;
        }
        .page-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
        }
        .page-header svg { color: var(--green); flex-shrink: 0; }
        .page-header h1 {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-bright);
            letter-spacing: -0.5px;
        }
        .page-header p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 28px;
            margin-bottom: 20px;
        }
        .field { margin-bottom: 20px; }
        .field:last-child { margin-bottom: 0; }
        label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        input[type="text"], textarea {
            width: 100%;
            padding: 12px 16px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: "Inter", sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }
        input[type="text"]:focus, textarea:focus {
            border-color: var(--green);
        }
        textarea {
            min-height: 220px;
            resize: vertical;
            line-height: 1.6;
        }
        .tabs {
            display: flex;
            gap: 4px;
            background: var(--surface);
            padding: 3px;
            border-radius: 8px;
            margin-bottom: 12px;
            width: fit-content;
        }
        .tab {
            padding: 7px 16px;
            font-size: 12px;
            font-weight: 600;
            background: transparent;
            border: none;
            color: var(--text-muted);
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .tab.active {
            background: var(--green);
            color: #fff;
        }
        .tab:hover:not(.active) { color: var(--text); background: var(--border); }
        .preview-frame {
            width: 100%;
            min-height: 220px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #fff;
            padding: 20px;
        }
        .btn-row {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .btn-send {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 28px;
            background: linear-gradient(135deg, var(--green-dark), var(--green));
            border: none;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(46, 160, 67, 0.25);
        }
        .btn-send:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(46, 160, 67, 0.35);
        }
        .btn-send:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .btn-back {
            padding: 13px 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.15s;
        }
        .btn-back:hover {
            border-color: var(--border-hover);
            color: var(--text);
        }
        .status {
            margin-top: 16px;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            display: none;
        }
        .status.success {
            display: block;
            background: rgba(46, 160, 67, 0.12);
            border: 1px solid rgba(46, 160, 67, 0.3);
            color: var(--green);
        }
        .status.error {
            display: block;
            background: rgba(248, 81, 73, 0.12);
            border: 1px solid rgba(248, 81, 73, 0.3);
            color: #f85149;
        }
        .status.loading {
            display: block;
            background: rgba(56, 132, 255, 0.12);
            border: 1px solid rgba(56, 132, 255, 0.3);
            color: #3884ff;
        }
        .user-count {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 20px;
        }
        .user-count strong { color: var(--text); }
    </style>
</head>
<body>

<div class="container">

    <div class="page-header">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <div>
            <h1>Broadcast Email</h1>
            <p>Send an email to all registered users</p>
        </div>
    </div>

    <div class="user-count">
        Sending to <strong><%= userCount %></strong> user<%= userCount === 1 ? '' : 's' %>
    </div>

    <form id="broadcastForm">
        <div class="card">
            <div class="field">
                <label>Subject</label>
                <input type="text" id="subject" name="subject" placeholder="e.g. Important update about Mudraaa" required>
            </div>
            <div class="field">
                <label>Email Body</label>
                <div class="tabs">
                    <button type="button" class="tab active" data-mode="write">Write</button>
                    <button type="button" class="tab" data-mode="preview">Preview</button>
                </div>
                <textarea id="body" name="body" placeholder="Write your email content here...&#10;&#10;HTML is supported."></textarea>
                <div id="previewArea" class="preview-frame" style="display:none;"></div>
            </div>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn-send" id="sendBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send to All Users
            </button>
            <a href="/dashboard" class="btn-back">Cancel</a>
        </div>

        <div class="status" id="status"></div>
    </form>

</div>

<script>
    const tabs = document.querySelectorAll(".tab");
    const bodyField = document.getElementById("body");
    const previewArea = document.getElementById("previewArea");
    const form = document.getElementById("broadcastForm");
    const sendBtn = document.getElementById("sendBtn");
    const status = document.getElementById("status");

    tabs.forEach(tab => {
        tab.addEventListener("click", () => {
            tabs.forEach(t => t.classList.remove("active"));
            tab.classList.add("active");

            if (tab.dataset.mode === "preview") {
                previewArea.innerHTML = bodyField.value;
                previewArea.style.display = "block";
                bodyField.style.display = "none";
            } else {
                previewArea.style.display = "none";
                bodyField.style.display = "block";
            }
        });
    });

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const subject = document.getElementById("subject").value.trim();
        const body = bodyField.value.trim();

        if (!subject || !body) {
            status.className = "status error";
            status.textContent = "Subject and body are required.";
            return;
        }

        sendBtn.disabled = true;
        sendBtn.textContent = "Sending...";
        status.className = "status loading";
        status.textContent = "Sending emails... This may take a moment.";

        try {
            const res = await fetch("/S@&deepKh@&al/broaecastEmail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ subject, body })
            });

            const data = await res.json();

            if (data.success) {
                status.className = "status success";
                status.textContent = data.message;
                form.reset();
                tabs[0].click();
            } else {
                status.className = "status error";
                status.textContent = data.error || "Failed to send emails.";
            }
        } catch (err) {
            status.className = "status error";
            status.textContent = "Network error. Please try again.";
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Send to All Users`;
        }
    });
</script>

</body>
</html>
